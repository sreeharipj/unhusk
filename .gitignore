/target

realval/out/*.debug
realval/out/*.stripped
claude_run.log

# Lab-notebook artifacts. The committed REPORTs and the CSV/JSON summaries are
# the record; run logs, periodic healthchecks and the cron wrappers that drove
# an overnight run are process noise and are kept local only.
*.log
**/HEALTHCHECK*
**/healthcheck.sh
**/wake_*.sh
work/
bench/run1/STATUS.md

# Per-run raw JSON, one file per (crate, config, rule) cell. Fully superseded by
# bench/origin/results.csv, which carries one row per file with the same fields;
# regenerate with evaluate.py if they are ever needed again.
bench/origin/results/

__pycache__/
*.pyc

# secrets — never commit API keys
.env
*.env

# downloaded malware samples — never commit, quarantine only, local disk
bench/malwarebazaar_survey/samples/
# operational run artifacts, not reproducible deliverables (confirmed_manifest.json
# and rejected_log.json are the committed record; these are just checkpoint/log noise)
bench/malwarebazaar_survey/state.json
bench/malwarebazaar_survey/run.log

# local build clones, stale batch outputs, and reference PDFs (not project artifacts)
realval/work/
realval/out2/
references/

# internal experiment notes / working docs
PLAN.md
RESEARCH_BACKLOG.md
panic-at-the-disassembler-preprint.md
panic-at-the-disassembler-preprint.pdf
panic-at-the-disassembler-supplementary.md
panic-at-the-disassembler-supplementary.pdf
# internal working notes: measurement writeups, spikes, and preprint prep.
# docs/ ships only what a reader needs; everything else lives here, unpublished.
docs/local/
PANIC_ORACLE_GAPS.md
context.md
RESULTS.md
HARNESS_VALIDATION_FINDINGS.md
bench/BENCHMARK_RESULTS.md
bench/CARGO_INSTALL_FIX.md
realval/ANCHOR_HEADROOM.md
realval/DEPTH_SWEEP.md
realval/RATIO_SEPARATION.md
