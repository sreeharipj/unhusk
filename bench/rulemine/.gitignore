# Derived data and build products. Everything here is regenerated by `make all`
# from the corpus binaries; none of it belongs in git.
#
# Sizes as of the study run, for scale: raw/ 911 MB, data/fde/ 142 MB, and the
# V3/V4 build trees carry unstripped binaries measured in gigabytes.
raw/
data/fde/
v2/raw/
v2/fde/
v2/gt/
v3/raw/
v3/fde/
v3/build/
v4/raw/
v4/fde/
v4/build/
v4/src/
v5/raw/
v5/fde/
v5/build/
v5/src/
extractor/target/
__pycache__/
*.pyc

# Kept in git deliberately, because they ARE the artifact:
#   manifest/binaries.csv   SHA-256 of every analysed binary
#   data/split.json         the sealed split and its hash
#   data/builds.csv         per-build row and label counts
#   v2/builds.csv v3/builds.csv v4/builds.csv v4/corpus.tsv
#   v5/builds.csv v5/corpus.tsv v5/corpus_candidates.tsv v5/split.json
#   results/*.json *.log    every experiment's output
#   figs/*.png              the figure
#   wild/*.json             the wild-sample yield report
!data/split.json
!data/builds.csv

# 28 MB of per-row out-of-fold model scores; regenerated by exp/e05_models.py
# and consumed only by figs/plot_frontier.py.
results/*.npz

_crates_block.txt
v5/build_v5.run.log
